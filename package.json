{
  "name": "@registrum/mcp",
  "mcpName": "io.github.RegistrumUK/uk-companies-house-mcp",
  "version": "2.1.1",
  "description": "UK Companies House due diligence and KYB: trace ownership to the beneficial owners, pull director histories, check ECCTA identity-verification status and deadlines, read parsed accounts. Live data, hosted, no API key. By Registrum.",
  "keywords": [
    "mcp",
    "mcp-server",
    "companies-house",
    "uk-companies",
    "company-data",
    "financials",
    "directors",
    "psc",
    "beneficial-ownership",
    "registrum"
  ],
  "homepage": "https://registrum.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RegistrumUK/uk-companies-house-mcp.git"
  },
  "license": "MIT",
  "author": "Eugene Merwe-Chartier",
  "type": "module",
  "main": "dist/server.js",
  "module": "dist/server.js",
  "types": "dist/server.d.ts",
  "bin": {
    "registrum-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "version": "node scripts/sync-server-json.mjs && git add server.json",
    "glama:check": "node scripts/glama/check.mjs",
    "glama:login": "node scripts/glama/login.mjs",
    "glama:sync": "node scripts/glama/sync.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/RegistrumUK/uk-companies-house-mcp/issues"
  }
}
