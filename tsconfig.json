{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Tests are run from source by vitest and must not be compiled into dist -
  // they were being published to npm as ~30kB of dead weight in every install.
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
